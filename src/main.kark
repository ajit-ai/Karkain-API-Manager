import live_service

// Karkain API Manager - first functional slice.
// API registration and policy/routing descriptor workflow.
// CONFIGURATION ONLY: stores descriptors, does not run a live gateway.

func rec_key(rec) {
    if (rec == "") { return "" }
    let f = split(rec, "|")
    return f[0] + "|" + f[1]
}

func put_record(state, rec) {
    if (rec == "") { return state }
    let key = rec_key(rec)
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let cur = state[i]
        if (cur == "") {
            push(out, cur)
        } else {
            if (rec_key(cur) == key) {
                push(out, rec)
                replaced = 1
            } else {
                push(out, cur)
            }
        }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func describe(state) {
    let n = 0
    let i = 0
    while (i < len(state)) {
        if (state[i] != "") {
            print("DESCRIPTOR " + state[i])
            n = n + 1
        }
        i = i + 1
    }
    print("DESCRIPTORS total=" + str(n))
}

func count_type(state, kind) {
    let n = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == kind) { n = n + 1 }
        i = i + 1
    }
    return n
}

func persist(path, lines) {
    let out = ""
    let i = 0
    while (i < len(lines)) {
        out = out + lines[i] + "\n"
        i = i + 1
    }
    writeFile(path, out)
}

func main() {
    let cmds = split(readFile("data/commands.dat"), "\n")
    let state = split(readFile("data/state.dat"), "\n")
    let report = ""
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = f[0]
            if (op == "API") {
                let rec = "API|" + f[1] + "|" + f[2] + "|" + f[3]
                state = put_record(state, rec)
                report = report + "API " + f[1] + " " + f[2] + " " + f[3] + "\n"
            }
            if (op == "POLICY") {
                let rec = "POLICY|" + f[1] + "|" + f[2]
                state = put_record(state, rec)
                report = report + "POLICY " + f[1] + " ratelimit=" + f[2] + "\n"
            }
            if (op == "PUBLISH") {
                let rec = "PUBLISHED|" + f[1]
                state = put_record(state, rec)
                report = report + "PUBLISH " + f[1] + "\n"
            }
            if (op == "ROUTE") {
                let rec = "ROUTE|" + f[1] + "|" + f[2]
                state = put_record(state, rec)
                report = report + "ROUTE " + f[1] + " " + f[2] + "\n"
            }
            if (op == "LIST") {
                describe(state)
                report = report + "LIST\n"
            }
        }
        i = i + 1
    }
    persist("data/state.dat", state)
    persist("data/report.dat", split(report, "\n"))
    print("API_MANAGER_OK apis=" + str(count_type(state, "API")) + " policies=" + str(count_type(state, "POLICY")) + " routes=" + str(count_type(state, "ROUTE")) + " published=" + str(count_type(state, "PUBLISHED")))
    live_service.serve_one_request()
}
