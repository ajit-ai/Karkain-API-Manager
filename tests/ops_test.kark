// Round 2 ops tests: one-shot local HTTP service logic (self-contained).

func test_http_request_line_parse() {
    let request = "GET /v1/users HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
    let lines = split(request, "\n")
    let first = lines[0]
    let parts = split(trim(first), " ")
    assert_eq(parts[0], "GET")
    assert_eq(parts[1], "/v1/users")
    assert_eq(parts[2], "HTTP/1.0")
}

func test_registered_descriptor_lookup() {
    let state = ["POLICY|users|100", "API|users|/v1/users|GET", "ROUTE|users|/api/users"]
    let found = ""
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "API") { found = state[i] }
        i = i + 1
    }
    let a = split(found, "|")
    assert_eq(a[1], "users")
    assert_eq(a[2], "/v1/users")
    assert_eq(a[3], "GET")
}

func test_http_response_format() {
    let name = "users"
    let path = "/v1/users"
    let method = "GET"
    let body = "api=" + name + ";path=" + path + ";method=" + method
    let response = "HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: " + str(len(body)) + "\r\n\r\n" + body
    assert_eq(contains(response, "HTTP/1.0 200 OK"), 1)
    assert_eq(contains(response, "Content-Length: 35"), 1)
    assert_eq(body, "api=users;path=/v1/users;method=GET")
}
