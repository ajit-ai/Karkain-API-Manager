func test_api_descriptor_record() {
    let rec = "API|users|/v1/users|GET"
    let f = split(rec, "|")
    assert_eq(f[0], "API")
    assert_eq(f[1], "users")
    assert_eq(f[2], "/v1/users")
    assert_eq(f[3], "GET")
}

func test_policy_ratelimit() {
    let rec = "POLICY|users|100"
    let f = split(rec, "|")
    assert_eq(f[0], "POLICY")
    let limit = int(f[2])
    assert_eq(limit, 100)
    assert_eq(limit * 2, 200)
}

func test_publish_and_route_descriptors() {
    let state = ["PUBLISHED|users", "ROUTE|users|/api/users"]
    let pub = 0
    let route = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "PUBLISHED") { pub = pub + 1 }
        if (f[0] == "ROUTE") { route = route + 1 }
        i = i + 1
    }
    assert_eq(pub, 1)
    assert_eq(route, 1)
    let r = split(state[1], "|")
    assert_eq(r[2], "/api/users")
}
